# OpenTiles sync service settings. Copy to .env for local development; in production set these
# in the container environment. See docs/sync.md.

# development | production. Production refuses http origins and the console mailer.
NODE_ENV=development
PORT=8787
HOST=0.0.0.0

# The web app's origin(s), comma-separated. CORS allows only these and passkeys are bound to them.
APP_ORIGIN=http://localhost:5173
# WebAuthn relying-party id: the app's registrable domain. Defaults to APP_ORIGIN's host name.
# RP_ID=opentiles.example
# RP_NAME=OpenTiles
# Sign-in link sent by email; {token} is replaced. Keep the token in the fragment (#).
# MAGIC_LINK_URL=http://localhost:5173/sync/sign-in#token={token}

# Metadata database (SQLite). Keep it on a persistent volume and back it up.
DATABASE_PATH=./data/sync.db

# Blob storage: fs (development) or s3 (any S3-compatible EU object storage).
STORAGE=fs
FS_ROOT=./data/blobs
# STORAGE=s3
# S3_ENDPOINT=https://s3.fr-par.scw.cloud
# S3_REGION=fr-par
# S3_BUCKET=opentiles-sync
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
# S3_PREFIX=

# Sign-in email: console (development only, prints links), smtp or http.
MAILER=console
# MAILER=smtp
# SMTP_URL=smtps://user:password@smtp.example.eu:465
# MAILER=http
# HTTP_MAILER_URL=https://api.mail-provider.example.eu/send
# HTTP_MAILER_TOKEN=
# MAIL_FROM=OpenTiles <no-reply@opentiles.example>

# Limits. QUOTA_BYTES defaults to 250 MB (250000000) per account.
# QUOTA_BYTES=250000000
# MAX_BLOB_BYTES=32000000
# MAX_BLOBS=100000

# Set to true only behind a reverse proxy that appends the client address to X-Forwarded-For.
# The address is used for in-memory rate limits and never stored.
TRUST_PROXY=false

# Opt-in anonymous crash reports (the app only sends them when the user switches them on).
CRASH_REPORTS=true
CRASH_RETENTION_DAYS=30
