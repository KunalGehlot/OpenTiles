# Response headers for static hosts that read this file (Netlify, Cloudflare Pages). On other hosts,
# set the same headers in the server configuration; the Content-Security-Policy is also in index.html
# as a <meta> tag, but frame-ancestors only works as a header. See docs/deploying.md.
# connect-src is the app's own origin only: a build with a sync server (VITE_SYNC_URL) must add that
# server's origin here too, or the header blocks it even though the <meta> tag allows it.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: microphone=(self), midi=(self), camera=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  X-Frame-Options: DENY

/sw.js
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable
