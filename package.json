{
  "name": "opentiles",
  "private": true,
  "description": "Free, open-source piano trainer for the browser",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @opentiles/web dev",
    "build": "pnpm -r build",
    "build:engine": "pnpm --filter @opentiles/engine build",
    "test": "pnpm -r test && pnpm test:tools",
    "test:tools": "node --test 'tools/licences/*.test.mjs'",
    "test:rust": "cargo test --workspace",
    "typecheck": "pnpm -r typecheck",
    "licences": "node tools/check-licences.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.0.0",
    "prettier": "^3.9.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
